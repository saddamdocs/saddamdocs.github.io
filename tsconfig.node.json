{
  // Type checking for code that runs in Node.js: the Vite, Vitest and Playwright configs,
  // the scripts, the rules tests and the Playwright tests.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // scripts/format1-fixture.ts runs with --experimental-transform-types and is checked by
  // tsconfig.test.json, because it imports app modules with parameter properties.
  "exclude": ["scripts/format1-fixture.ts"],
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/rules/**/*.ts",
    "tests/ui/**/*.ts",
    "tests/support/**/*.ts"
  ]
}
