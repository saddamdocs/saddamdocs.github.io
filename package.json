{
  "name": "tamandua",
  "version": "0.0.2",
  "private": true,
  "description": "Tamanduá: an offline-first Markdown notes web app with live preview and encrypted sync.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build:next": "vite build --mode next",
    "build:stable": "vite build --mode stable",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "npm run check:types && npm run check:svelte && npm run lint && npm run format:check",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --project demo-tamandua --only database \"vitest run --project rules\"",
    "test:ui": "npm run build:next && npm run build:emulator && firebase emulators:exec --project demo-tamandua --only database \"playwright test --project chromium\"",
    "test:brave": "npm run build:next && npm run build:emulator && firebase emulators:exec --project demo-tamandua --only database \"playwright test --project brave\"",
    "check:origins": "node scripts/check-origins.ts",
    "check:size": "node scripts/check-size.ts",
    "icons": "node scripts/icons.ts",
    "build:emulator": "vite build --mode emulator"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "idb": "8.0.4",
    "svelte": "5.58.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.5.0",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "firebase-tools": "15.37.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
